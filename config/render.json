{
  "theme": {
    "accent": "#1f4e79",
    "muted": "#5a6472",
    "rule": "#c9d2dd",
    "boxBackground": "#f4f7fa"
  },
  "layout": {
    "fontScale": 1.0,
    "marginMm": 18.0,
