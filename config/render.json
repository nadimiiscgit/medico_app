      "A",
      "B",
      "C"
    ],
    "include": {
      "oneLiner": true,
      "mustKnow": true,
      "concept": true,
      "table": true,
      "mnemonic": true,
      "pitfalls": true,
      "repeats": true,
      "crossref": true
    }
  }
}
